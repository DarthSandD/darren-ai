{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darren Ai",
  "version": "0.1.0",
  "identifier": "com.darrenai.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Darren Ai",
        "width": 1180,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
