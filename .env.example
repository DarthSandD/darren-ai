# ---- Detector ----
DARREN_DETECTOR_ENGINE=stub
DARREN_BASE_MODEL=Qwen/Qwen2.5-1.5B
DARREN_ALIGNED_MODEL=Qwen/Qwen2.5-1.5B-Instruct
DARREN_DEVICE=auto
DARREN_DETECT_THRESHOLD=0.5

# ---- Humanizer ----
DARREN_HUMANIZER_REWRITER=template
DARREN_HUMANIZER_MAX_ROUNDS=5
DARREN_HUMANIZER_TARGET=0.35
DARREN_HUMANIZER_BEST_OF=3
DARREN_HUMANIZER_MIN_SIMILARITY=0.6

# ---- Optional LLM rewriter ----
DARREN_LLM_BASE_URL=
DARREN_LLM_API_KEY=
DARREN_LLM_MODEL=deepseek-chat

# ---- Limits ----
DARREN_MAX_INPUT_CHARS=60000
DARREN_CORS_ORIGINS=*
